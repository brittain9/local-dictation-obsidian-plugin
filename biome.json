{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!.superpowers",
      "!assets",
      "!data.json",
      "!main.js",
      "!main.js.map",
      "!node_modules",
      "!native/bergamot/bergamot-translator-v0.6.0-cjk-html.js",
      "!package-lock.json",
      "!native/**/target",
      "!native/**/target-cuda",
      "!references",
      "!tasks"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
