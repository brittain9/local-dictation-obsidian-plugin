+bool hasPrimaryLanguage(std::string_view language, std::string_view primaryLanguage) {
+  return language == primaryLanguage ||
+         (language.size() > primaryLanguage.size() &&
+          language.compare(0, primaryLanguage.size(), primaryLanguage) == 0 &&
+          language[primaryLanguage.size()] == '-');
+}
+
+bool omitsSpacesBetweenWords(std::string_view language) {
+  return hasPrimaryLanguage(language, "ja") || hasPrimaryLanguage(language, "zh");
+}
+
+bool isAscii(marian::string_view value) {
+  return std::all_of(value.begin(), value.end(), [](unsigned char character) { return character < 0x80; });
+}
+
+bool isUnicodePunctuation(char32_t codePoint) {
+  return (codePoint >= 0x2000 && codePoint <= 0x206F) ||
+         (codePoint >= 0x2E00 && codePoint <= 0x2E7F) ||
+         (codePoint >= 0x3000 && codePoint <= 0x303F) ||
+         (codePoint >= 0xFE10 && codePoint <= 0xFE1F) ||
+         (codePoint >= 0xFE30 && codePoint <= 0xFE4F) ||
+         (codePoint >= 0xFF01 && codePoint <= 0xFF0F) ||
+         (codePoint >= 0xFF1A && codePoint <= 0xFF20) ||
+         (codePoint >= 0xFF3B && codePoint <= 0xFF40) ||
+         (codePoint >= 0xFF5B && codePoint <= 0xFF65);
+}
+
+bool nextCodePoint(marian::string_view value, size_t &offset, char32_t &codePoint) {
+  auto const lead = static_cast<unsigned char>(value[offset++]);
+  if (lead < 0x80) {
+    codePoint = lead;
+    return true;
+  }
+
+  size_t continuationCount;
+  if ((lead & 0xE0) == 0xC0) {
+    codePoint = lead & 0x1F;
+    continuationCount = 1;
+  } else if ((lead & 0xF0) == 0xE0) {
+    codePoint = lead & 0x0F;
+    continuationCount = 2;
+  } else if ((lead & 0xF8) == 0xF0) {
+    codePoint = lead & 0x07;
+    continuationCount = 3;
+  } else {
+    return false;
+  }
+
+  if (continuationCount > value.size() - offset) return false;
+  for (size_t index = 0; index < continuationCount; ++index) {
+    auto const continuation = static_cast<unsigned char>(value[offset++]);
+    if ((continuation & 0xC0) != 0x80) return false;
+    codePoint = (codePoint << 6) | (continuation & 0x3F);
+  }
+  return true;
+}
+
+bool isNonAsciiPunctuation(marian::string_view value) {
+  bool foundNonAscii = false;
+  bool foundPunctuation = false;
+  for (size_t offset = 0; offset < value.size();) {
+    char32_t codePoint;
+    if (!nextCodePoint(value, offset, codePoint)) return false;
+    if (codePoint < 0x80) {
+      auto const character = static_cast<unsigned char>(codePoint);
+      if (std::isspace(character)) continue;
+      if (!std::ispunct(character)) return false;
+    } else {
+      foundNonAscii = true;
+      if (!isUnicodePunctuation(codePoint)) return false;
+    }
+    foundPunctuation = true;
+  }
+  return foundNonAscii && foundPunctuation;
+}
