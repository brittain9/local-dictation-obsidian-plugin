+bool HTML::isTargetContinuation(AnnotatedText const &target, marian::string_view prev, marian::string_view str) const {
+  // Japanese and Chinese do not expose word boundaries with spaces. Treating
+  // every target subword as one continuation causes the smoothing below to
+  // collapse an entire sentence onto one source span, moving all inline HTML
+  // to the start of the translation. Still smooth adjacent ASCII tokens so
+  // mixed-script terms such as "Ctrl+S" remain a single formatted word.
+  if (omitsSpacesBetweenWords(target.targetLanguage()) && (!isAscii(prev) || !isAscii(str))) return false;
+  return isContinuation(prev, str);
+}
